                    {
                        "type": "string",
                        "description": "Customer ID",
                        "name": "X-Customer-ID",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Order request payload",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/request.PlaceOrderRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.SuccessResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/response.OrderResponse"
                                        }
                                    }
                                }
                            ]
